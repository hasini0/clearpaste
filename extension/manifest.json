{
  "manifest_version": 3,
  "name": "ClearPaste — explain this page",
  "version": "1.0.0",
  "description": "Select confusing text on any website and get it in plain words, with deadlines and scam warnings.",
  "action": { "default_popup": "popup.html", "default_title": "Explain with ClearPaste" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Explain the selected text" }
  }
}
